@page "/acquisition/channels"
@implements IDisposable

<PageTitle>Channels - PiwikPRO Analytics</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Acquisition Channels</MudText>

<DateRangePicker OnDateRangeChanged="OnDateRangeChanged" />

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else if (_data != null && _data.Any())
{
    <MudPaper Elevation="2" Class="pa-4 mt-4">
        <MudDataGrid Items="@_data" Filterable="true" SortMode="SortMode.Multiple" 
                     Hover="true" Dense="true">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Channel Performance</MudText>
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="x => x.Channel" Title="Channel" />
                <PropertyColumn Property="x => x.Sessions" Title="Sessions" Format="N0" />
                <PropertyColumn Property="x => x.PageViews" Title="Page Views" Format="N0" />
                <PropertyColumn Property="x => x.BounceRate" Title="Bounce Rate %" Format="F1" />
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        <MudTooltip Text="Add as filter">
                            <MudIconButton Icon="@Icons.Material.Filled.FilterAlt" 
                                         Color="Color.Primary" 
                                         Size="Size.Small"
                                         OnClick="@(() => AddChannelFilter(context.Item))" />
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudPaper>

    <MudGrid Class="mt-4">
        <MudItem xs="12" md="6">
            <MudPaper Elevation="2" Class="pa-4">
                <MudText Typo="Typo.h6" GutterBottom="true">Sessions by Channel</MudText>
                <MudChart ChartType="ChartType.Pie" 
                          InputData="@_data.Select(x => (double)x.Sessions).ToArray()"
                          InputLabels="@_data.Select(x => x.Channel).ToArray()"
                          Width="100%" Height="350px" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Elevation="2" Class="pa-4">
                <MudText Typo="Typo.h6" GutterBottom="true">Bounce Rate by Channel</MudText>
                <MudChart ChartType="ChartType.Bar" 
                          ChartSeries="@_bounceRateSeries"
                          ChartOptions="@_bounceRateChartOptions"
                          XAxisLabels="@_data.Select(x => x.Channel).ToArray()"
                          Width="100%" Height="350px" />
            </MudPaper>
        </MudItem>
    </MudGrid>
}
