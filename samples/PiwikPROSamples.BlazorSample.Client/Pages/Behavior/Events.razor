@page "/behavior/events"

<PageTitle>Events - PiwikPRO Analytics</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Event Tracking</MudText>

<DateRangePicker OnDateRangeChanged="OnDateRangeChanged" />

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else
{
    <MudPaper Elevation="2" Class="pa-4 mt-4">
        <MudText Typo="Typo.h6" GutterBottom="true">Events Overview</MudText>
        <MudAlert Severity="Severity.Info">
            Event tracking data will be available when custom events are configured in your PiwikPRO instance.
        </MudAlert>
    </MudPaper>
}
