{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "piwikpro-api": {
        "ClusterId": "piwikpro-cluster",
        "Match": {
          "Path": "/api/proxy/{hostname}/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "piwikpro-cluster": {
        "Destinations": {
          "piwikpro-destination": {
            "Address": "https://placeholder.piwik.pro"
          }
        }
      }
    }
  }
}
